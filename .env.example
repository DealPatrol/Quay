# Quay environment variables — copy to .env.local and fill in.
# On Vercel: paste these into Settings → Environment Variables (Production).

# ── Download-token signing ─────────────────────────────────────────────
# HMAC secret for signing secure download links. REQUIRED in production.
# Generate:  openssl rand -hex 32
QUAY_SECRET=change-me-to-a-long-random-string

# ── Stripe (real payments) ─────────────────────────────────────────────
# Where each value comes from (Stripe Dashboard):
#
# 1. STRIPE_SECRET_KEY
#    Developers → API keys → "Secret key" → Reveal → copy.
#    Use sk_test_… while testing, sk_live_… when you go live.
#
# 2. NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#    Developers → API keys → "Publishable key" → copy.
#    Public by design (it's in your frontend). Prefilled below with the
#    live publishable key you provided.
#
# 3. STRIPE_WEBHOOK_SECRET
#    Developers → Webhooks → Add endpoint →
#      Endpoint URL: https://<your-domain>/api/webhooks/stripe
#      Events to send: select `checkout.session.completed`
#    → Add endpoint → Reveal the "Signing secret" (whsec_…) → copy.
#    Stripe retries failed deliveries for days, so set this before selling.
#
# Leave STRIPE_SECRET_KEY empty to run in DEMO mode (no real charges).

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51TfxBvRJZZUpaweBw2b2A5HIjr7pw81nbS35KQltxOc0hI4aM2oVE8fIzyHzX6dJxXVcta53XQs3EteYVKpEerna00FIBSAfNt

# Public base URL of your deployed store — used to build Stripe's
# success/cancel redirect URLs. No trailing slash.
# Local: http://localhost:3000 · Vercel: https://your-store.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin auth (dashboard login) ─────────────────────────────────────
# Set = real password login at /dashboard/login (bcrypt-verified, httpOnly
# HMAC session cookie, 7-day expiry). Unset = any-email demo gate with a
# "demo auth" sticker. Generate the hash with:
#   node scripts/make-admin-hash.mjs "your-strong-password"
# then paste the printed line here.
ADMIN_PASSWORD_HASH=

# ── Postgres (optional database) ─────────────────────────────────────
# Set = all persistence uses Postgres via `pg`. Unset = JSON files in data/.
# Run the schema once first:  psql "$DATABASE_URL" -f scripts/schema.sql
# Works with Neon, Supabase, RDS, or local Postgres.
DATABASE_URL=

# ── Email receipts (optional) ────────────────────────────────────────
# Set RESEND_API_KEY = buyers get an HTML receipt with their secure
# download links on every finalized order. Unset = skipped silently.
# Failures never break checkout. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# From address for receipts (default: Quay <orders@<your-site-host>>)
RESEND_FROM=

# ── Meta Pixel + Conversions API (optional ad tracking) ──────────────
# 1. NEXT_PUBLIC_META_PIXEL_ID — Events Manager → Data sources → your pixel
#    → copy the numeric Pixel ID. Enables the browser pixel (PageView,
#    ViewContent, AddToCart, InitiateCheckout, Purchase). Unset = no pixel.
# 2. META_CAPI_TOKEN — same pixel → Settings → Conversions API →
#    "Generate access token". Enables server-side events (deduped with the
#    pixel by event id, so ad-blocked checkouts still attribute). Unset =
#    browser pixel only.
# 3. META_TEST_EVENT_CODE (optional) — Events Manager → Test events → copy
#    the test code. Events land in Test events instead of live reporting.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ── Abandoned-cart cron (optional) ────────────────────────────────────
# Point any cron provider at POST /api/checkout/abandon/remind with
# {"cronSecret": "<this value>"} (or header x-cron-secret). Carts older than
# 4 hours (ABANDON_REMIND_AFTER_HOURS) get one automatic reminder.
CRON_SECRET=
ABANDON_REMIND_AFTER_HOURS=4
